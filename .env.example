# Copy this file to .env and fill in your values.

PLEX_URL=http://plex:32400
PLEX_TOKEN=

RADARR_URL=http://radarr:7878
RADARR_API_KEY=

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# Every unmonitarr.py flag can also be set as an env var (uncomment to
# override the defaults set in docker-compose.yml). Booleans accept
# 1/true/yes/on, case-insensitive.
# APPLY=true
# HIDE_ALREADY_UNMONITORED=true
# SKIP_MOVIES=false
# SKIP_SHOWS=false
# DELETE_MOVIES=false
# DELETE_EPISODES=false
# DELETE_FILES=false
# MOVIE_LIBRARY=Movies
# SHOW_LIBRARY=TV Shows
# UNMONITOR_AFTER_DAYS=0
# DELETE_AFTER_DAYS=90
# FILTER=
